# 로컬 개발용 — 이 파일을 .env로 복사해서 사용하세요
# 서버 배포 시에는 provision 과정에서 자동으로 설정됩니다
#
# ※ 모든 env 는 app/config.py 한 곳에서 읽습니다. 새 변수는 거기에 추가하세요.

PORT=8000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASS=mypassword

# ── 프론트에 내려줄 공개 키 (GET /config) ─────────────────────
# 서버 배포 시에는 선생님 공유 키(config/maps.env)가 자동 주입됩니다.
# 로컬에서 테스트할 때만 아래 주석을 풀고 값을 채우세요.
# NAVER_MAPS_CLIENT_ID=
# KAKAO_MAPS_APP_KEY=

# ── NEIS 나이스 교육정보 개방포털 Open API ─────────────────────
# https://open.neis.go.kr 에서 발급받은 인증키 (미입력 시 공개 트래픽 제한 적용)
NEIS_API_KEY=

# ── 유튜브 먹방 영상 검색 (app/services/youtube.py) ────────────
# Google Cloud Console → "YouTube Data API v3" 사용 설정 → API 키 발급
# 무료 할당량 하루 10,000유닛 (search.list 1회당 100유닛)이라, 검색어당 1회만
# 호출하고 결과를 DB(youtube_caches)에 저장해 재사용합니다.
# 비워두면 영상 없이 "준비 중" 상태로 동작합니다.
YOUTUBE_API_KEY=

# ── AI 학교소개 생성 (app/services/ai_provider.py) ─────────────
# 학교당 최초 1회만 호출되고 결과는 DB에 캐시됩니다.
# 키가 비어있으면 StubAIProvider(더미)로 자동 대체됩니다.
# AI_PROVIDER: gemini | claude | stub
AI_PROVIDER=gemini

# Gemini — https://aistudio.google.com 에서 API 키 발급 (가장 저렴한 옵션)
# GEMINI_MODEL은 비워두면 gemini-2.5-flash-lite. 단가/모델명이 바뀌므로
# AI Studio 가격표에서 현재 최저가 모델을 확인해 조정하세요.
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude로 전환할 때만 필요 (AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
